{
  "name": "coperativeai",
  "version": "0.2.0",
  "description": "A way of working that Product, Developers, QA and AI share: plain-English briefs, specs the AI translates rather than authors, and debt it has to declare.",
  "type": "module",
  "bin": {
    "coperativeai": "bin/coperativeai.mjs"
  },
  "files": [
    "bin",
    "template/Project_brief.md",
    "template/_forms",
    "template/ai-only",
    "template/qa",
    "template/AGENTS.template.md",
    "!template/README.md",
    ".claude/commands",
    ".claude/skills",
    ".claude/settings.json",
    ".cursor/skills",
    ".agents/skills",
    ".gemini/commands",
    ".opencode/commands",
    ".github/prompts",
    ".kiro/prompts",
    "tools/*-lint.mjs",
    "tools/check.mjs",
    "tools/lib",
    "tools/hooks",
    "README.md",
    "HOW-TO-USE.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tools/*.test.mjs\"",
    "check": "npm test && node tools/check.mjs",
    "prepublishOnly": "node tools/known-versions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Peter Partridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterPartridge/CooperativeAICoding.git"
  },
  "homepage": "https://peterpartridge.github.io/CooperativeAICoding/",
  "bugs": {
    "url": "https://github.com/PeterPartridge/CooperativeAICoding/issues"
  },
  "keywords": [
    "spec-driven-development",
    "ai-agents",
    "claude-code",
    "product-management",
    "technical-debt"
  ]
}
