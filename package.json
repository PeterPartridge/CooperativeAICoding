{
  "name": "coperativeai",
  "version": "0.1.0",
  "description": "A way of working that Product, Developers, QA and AI share: plain-English briefs, specs the AI translates rather than authors, and debt it has to declare.",
  "type": "module",
  "bin": {
    "coperativeai": "bin/coperativeai.mjs"
  },
  "files": [
    "bin",
    "template/Project_brief.md",
    "template/_forms",
    "template/ai-only",
    "template/qa",
    "template/AGENTS.template.md",
    "!template/README.md",
    ".claude/commands",
    ".claude/skills",
    "tools/brief-lint.mjs",
    "tools/code-map-lint.mjs",
    "tools/round-record-lint.mjs",
    "tools/spec-lint.mjs",
    "README.md",
    "HOW-TO-USE.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tools/lint.test.mjs tools/commands.test.mjs",
    "check": "npm test && node tools/code-map-lint.mjs && node tools/brief-lint.mjs && node tools/round-record-lint.mjs && node tools/spec-lint.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Peter Partridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterPartridge/CooperativeAICoding.git"
  },
  "homepage": "https://peterpartridge.github.io/CooperativeAICoding/",
  "bugs": {
    "url": "https://github.com/PeterPartridge/CooperativeAICoding/issues"
  },
  "keywords": [
    "spec-driven-development",
    "ai-agents",
    "claude-code",
    "product-management",
    "technical-debt"
  ]
}
